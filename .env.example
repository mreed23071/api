# ---------------------------------------------------------------------------
# Database (compose injects its own value; this is for running outside Docker)
# ---------------------------------------------------------------------------
POSTGRES_USER=mabinsoft
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=mabinsoft
DATABASE_URL=postgresql+asyncpg://mabinsoft:change-me-in-production@localhost:5432/mabinsoft

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# Structured JSON logs. Set false for readable local output.
LOG_JSON=false
# Interactive docs at /docs. Forced off in production by the startup guard.
DOCS_ENABLED=true
API_ROOT_PREFIX=/api
# JSON array - origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Authentication
#
# Preferred: issue scoped API keys. Each key becomes a Principal with exactly
# the scopes listed, which every service asserts before doing anything.
# Valid scopes: ingest:run, ingest:read, insights:read, messages:read, admin
# ---------------------------------------------------------------------------
API_KEYS=[{"key":"local-dev-cron-token","subject":"cron-scheduler","scopes":["ingest:run","ingest:read"]},{"key":"local-dev-reader-token","subject":"local-frontend","scopes":["insights:read","messages:read"]}]

# Legacy single-secret fallback, used only when API_KEYS is empty. Accepted on
# both X-API-Key and the original X-Cron-Token header.
CRON_TOKEN=local-dev-cron-token

# Header-based user impersonation (X-Dev-User / X-Dev-Scopes) for local work.
# The startup guard refuses to boot with this enabled in production.
DEV_AUTH_ENABLED=true
DEV_AUTH_SCOPES=["insights:read","messages:read"]

# ---------------------------------------------------------------------------
# Embeddings (always local - message bodies never leave the network)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
# "thread" (default) or "process". See app/shared/embeddings/encoder.py.
EMBEDDING_EXECUTOR=thread
EMBEDDING_WORKERS=1
EMBEDDING_TORCH_THREADS=2
# Load the model during startup so no request pays the cold-start cost.
EMBEDDING_WARMUP_ON_STARTUP=true

# ---------------------------------------------------------------------------
# LLM (agentic filtering + summarization)
# "stub"      -> deterministic local heuristic, no network, no credentials
# "anthropic" -> Anthropic Messages API, requires ANTHROPIC_API_KEY
# ---------------------------------------------------------------------------
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Agent prompts (configurable without a code change)
# ---------------------------------------------------------------------------
INGESTION_FILTER_SYSTEM_PROMPT="Filter out personal messages and retain only business-related messages."
# Bump whenever a prompt changes; stored on every message the filter decides on.
PROMPT_VERSION=v1
SUMMARY_SYSTEM_PROMPT="You summarize a person's communication history. Produce a concise, factual, third-person summary of at most three sentences covering recurring topics, responsibilities and open threads. Do not invent details."
